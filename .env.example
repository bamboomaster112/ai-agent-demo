# Supabase (new key naming: publishable replaces anon, secret replaces service_role)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
SUPABASE_SECRET_KEY=sb_secret_your-key

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-your-key

# Voyage AI (Anthropic's official embedding partner - https://www.voyageai.com)
VOYAGE_API_KEY=pa-your-key

# Backend
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
SECRET_KEY=change-this-to-a-random-secret

# Defaults (overridable by admin)
DEFAULT_MODEL=claude-sonnet-4-20250514
DEFAULT_TEMPERATURE=0.3
DEFAULT_MAX_TOKENS=4096
